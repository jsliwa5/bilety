{
    "variable":  [
                     {
                         "key":  "baseUrl",
                         "type":  "string",
                         "value":  "http://localhost:5000"
                     }
                 ],
    "info":  {
                 "description":  "Kolekcja do przetestowania flow aplikacji PTickets krok po kroku.",
                 "name":  "PTickets API Smoke Test",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "item":  [
                 {
                     "request":  {
                                     "method":  "GET",
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/zones",
                                                 "path":  [
                                                              "api",
                                                              "zones"
                                                          ]
                                             }
                                 },
                     "name":  "01. Pobierz Strefy (Zapisz ZoneId i StreetId)",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "var jsonData = pm.response.json();",
                                                                   "pm.environment.set(\u0027zoneId\u0027, jsonData[0].id);",
                                                                   "pm.environment.set(\u0027streetId\u0027, jsonData[0].streets[0].id);"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
                 },
                 {
                     "request":  {
                                     "method":  "GET",
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/violation-types",
                                                 "path":  [
                                                              "api",
                                                              "violation-types"
                                                          ]
                                             }
                                 },
                     "name":  "02. Pobierz Typy Naruszeń (Zapisz ViolationTypeId)",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "var jsonData = pm.response.json();",
                                                                   "pm.environment.set(\u0027violationTypeId\u0027, jsonData[0].id.value);"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
                 },
                 {
                     "request":  {
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/inspectors",
                                                 "path":  [
                                                              "api",
                                                              "inspectors"
                                                          ]
                                             },
                                     "method":  "POST",
                                     "body":  {
                                                  "raw":  "{\"firstName\": \"Jan\", \"lastName\": \"Kowalski\"}",
                                                  "mode":  "raw"
                                              },
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 },
                     "name":  "03. Utwórz Inspektora (Zapisz InspectorId)",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "var jsonData = pm.response.json();",
                                                                   "pm.environment.set(\u0027inspectorId\u0027, jsonData.id);"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
                 },
                 {
                     "request":  {
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/sessions",
                                                 "path":  [
                                                              "api",
                                                              "sessions"
                                                          ]
                                             },
                                     "method":  "POST",
                                     "body":  {
                                                  "raw":  "{\"inspectorId\": \"{{inspectorId}}\"}",
                                                  "mode":  "raw"
                                              },
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 },
                     "name":  "04. Rozpocznij Sesję (Zapisz SessionId)",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.environment.set(\u0027sessionId\u0027, pm.response.text().replace(/\"/g, \u0027\u0027));"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
                 },
                 {
                     "name":  "05. Wybierz Ulicę i Strefę",
                     "request":  {
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/sessions/{{sessionId}}/street",
                                                 "path":  [
                                                              "api",
                                                              "sessions",
                                                              "{{sessionId}}",
                                                              "street"
                                                          ]
                                             },
                                     "method":  "PUT",
                                     "body":  {
                                                  "raw":  "{\"zoneId\": \"{{zoneId}}\", \"streetId\": \"{{streetId}}\"}",
                                                  "mode":  "raw"
                                              },
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 }
                 },
                 {
                     "request":  {
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/inspections",
                                                 "path":  [
                                                              "api",
                                                              "inspections"
                                                          ]
                                             },
                                     "method":  "POST",
                                     "body":  {
                                                  "raw":  "{\"sessionId\": \"{{sessionId}}\", \"registrationNumber\": \"WZW1234\", \"latitude\": 51.0, \"longitude\": 17.0}",
                                                  "mode":  "raw"
                                              },
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 },
                     "name":  "06. Rozpocznij Kontrolę Pojazdu (Zapisz InspectionId)",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.environment.set(\u0027inspectionId\u0027, pm.response.text().replace(/\"/g, \u0027\u0027));"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
                 },
                 {
                     "name":  "07. Weryfikuj Bilet",
                     "request":  {
                                     "method":  "POST",
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/inspections/{{inspectionId}}/check-ticket",
                                                 "path":  [
                                                              "api",
                                                              "inspections",
                                                              "{{inspectionId}}",
                                                              "check-ticket"
                                                          ]
                                             },
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 }
                 },
                 {
                     "name":  "08. Przeprowadź Drugą Kontrolę (Dla braku biletu)",
                     "request":  {
                                     "method":  "POST",
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/inspections/{{inspectionId}}/second-check",
                                                 "path":  [
                                                              "api",
                                                              "inspections",
                                                              "{{inspectionId}}",
                                                              "second-check"
                                                          ]
                                             },
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 }
                 },
                 {
                     "name":  "09. Dodaj Naruszenie",
                     "request":  {
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/inspections/{{inspectionId}}/violations",
                                                 "path":  [
                                                              "api",
                                                              "inspections",
                                                              "{{inspectionId}}",
                                                              "violations"
                                                          ]
                                             },
                                     "method":  "POST",
                                     "body":  {
                                                  "raw":  "{\"violationTypeId\": \"{{violationTypeId}}\"}",
                                                  "mode":  "raw"
                                              },
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 }
                 },
                 {
                     "name":  "10. Załącz Zdjęcia",
                     "request":  {
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/inspections/{{inspectionId}}/photos",
                                                 "path":  [
                                                              "api",
                                                              "inspections",
                                                              "{{inspectionId}}",
                                                              "photos"
                                                          ]
                                             },
                                     "method":  "POST",
                                     "body":  {
                                                  "raw":  "{\"fileIds\": [\"00000000-0000-0000-0000-000000000001\", \"00000000-0000-0000-0000-000000000002\"]}",
                                                  "mode":  "raw"
                                              },
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 }
                 },
                 {
                     "request":  {
                                     "method":  "POST",
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/inspections/{{inspectionId}}/notice",
                                                 "path":  [
                                                              "api",
                                                              "inspections",
                                                              "{{inspectionId}}",
                                                              "notice"
                                                          ]
                                             },
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 },
                     "name":  "11. Wystaw Zawiadomienie (Mandat) (Zapisz NoticeId)",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.environment.set(\u0027noticeId\u0027, pm.response.text().replace(/\"/g, \u0027\u0027));"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
                 },
                 {
                     "name":  "12. Pobierz Zawiadomienie (Weryfikacja)",
                     "request":  {
                                     "method":  "GET",
                                     "url":  {
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "raw":  "{{baseUrl}}/api/notices/{{noticeId}}",
                                                 "path":  [
